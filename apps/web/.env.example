# Скопируйте в apps/web/.env.local

# Адрес API для серверных компонентов (SSR/ISR).
# Не задан — данные берутся из встроенных моков (@apex/mocks) прямо в процессе Next.
# API_URL=http://localhost:4000

# Адрес API для браузера (конфигуратор, заявки, админка). Не задан вместе с
# NEXT_PUBLIC_API_MOCKING=enabled — запросы из браузера перехватывает MSW (админка без API не работает).
# NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_MOCKING=enabled

# Публичный адрес сайта — для metadataBase, OpenGraph и sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile: ключ сайта. Этот — официальный тестовый (виджет всегда пропускает)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Секрет вебхука ревалидации ISR — тот же, что REVALIDATE_SECRET у API
REVALIDATE_SECRET=
