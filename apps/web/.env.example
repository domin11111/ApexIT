# Скопируйте в apps/web/.env.local

# Адрес API для серверных компонентов (SSR/ISR).
# Не задан — данные берутся из встроенных моков (@apex/mocks) прямо в процессе Next.
# API_URL=http://localhost:4000

# Адрес API для браузера. Не задан вместе с NEXT_PUBLIC_API_MOCKING=enabled —
# запросы из браузера перехватывает MSW.
# NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_MOCKING=enabled

# Публичный адрес сайта — для metadataBase, OpenGraph и sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
