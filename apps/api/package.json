{
  "name": "@apex/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "worker": "tsx watch --clear-screen=false src/worker.ts",
    "build": "tsdown",
    "start": "node dist/server.mjs",
    "start:worker": "node dist/worker.mjs",
    "openapi": "tsx src/scripts/export-openapi.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "admin:create": "tsx src/scripts/admin-create.ts",
    "admin:dev-login": "tsx src/scripts/admin-dev-login.ts"
  },
  "dependencies": {
    "@apex/collection": "workspace:*",
    "@apex/contracts": "workspace:*",
    "@apex/domain": "workspace:*",
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/etag": "^6.2.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@gltf-transform/cli": "^4.5.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^6.3.8",
    "close-with-grace": "^2.5.0",
    "dotenv": "^17.2.3",
    "draco3dgltf": "^1.5.7",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "meshoptimizer": "^1.2.0",
    "nodemailer": "^10.0.10",
    "openapi-types": "^12.1.3",
    "pino": "^10.3.1",
    "prisma": "^7.10.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@apex/config": "workspace:*",
    "@apex/mocks": "workspace:*",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.11.0",
    "msw": "^2.15.0",
    "pino-pretty": "^13.1.3",
    "testcontainers": "^12.1.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
