# Скопируйте в .env (корень) — его читают docker compose и apps/api.
# apps/api/.env, если есть, имеет приоритет над корневым.

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=apex
POSTGRES_PASSWORD=apex
POSTGRES_DB=apex
DATABASE_URL=postgresql://apex:apex@localhost:5432/apex

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API ────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=4000
# Публичный адрес — попадает в servers документа OpenAPI
# API_PUBLIC_URL=https://api.example.com
# Origin фронта для CORS, через запятую
WEB_ORIGIN=http://localhost:3000
# true — только за доверенным прокси: IP клиента для rate limit берётся из X-Forwarded-For
TRUST_PROXY=false
LOG_LEVEL=info
CACHE_TTL_SECONDS=300
# Запросов в минуту с одного IP
RATE_LIMIT_MAX=300

# ── Сид ────────────────────────────────────────────────────
# В production сид не перезаписывает существующие продукты (правки из админки),
# пока явно не задано SEED_FORCE=1.
# SEED_FORCE=1

# ── S3 (локально — RustFS из docker-compose) ────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=apex-assets
S3_ACCESS_KEY=apex
S3_SECRET_KEY=apex-s3-secret
# Публичный адрес готовых ассетов (CDN). Локально — само хранилище: бакет/public открыт на чтение
ASSET_PUBLIC_URL=http://localhost:9000/apex-assets
# Создать бакет, политику чтения public/… и CORS при старте API (только для локальной разработки)
S3_AUTO_SETUP=true
# Папка KTX-Software (ktx, toktx) для сжатия текстур в KTX2; не задана — ищется в PATH, нет — текстуры как есть
# KTX_SOFTWARE_DIR=C:/Program Files/KTX-Software/bin

# ── Заявки ─────────────────────────────────────────────────
# Cloudflare Turnstile. Ключи ниже — официальные тестовые (всегда «успех»); боевые — из панели Cloudflare
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Соль для хеша IP в заявках (антиспам без хранения адресов)
LEAD_IP_SALT=change-me
# Письма менеджерам. Локально — Mailpit (http://localhost:8025)
SMTP_URL=smtp://localhost:1025
MAIL_FROM="APEX Compute <no-reply@apex.local>"
LEAD_NOTIFY_EMAILS=sales@apex.local
# Telegram: токен от @BotFather и ID чата менеджеров. Не заданы — уведомления только на почту
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Админка ────────────────────────────────────────────────
# Ключ шифрования секретов TOTP: 32 байта в base64 (openssl rand -base64 32)
TOTP_ENCRYPTION_KEY=
# Время жизни сессии админки, часов
ADMIN_SESSION_HOURS=12
# Вход по одноразовой ссылке из CLI (pnpm --filter @apex/api admin:dev-login) — только development
# ADMIN_DEV_LOGIN=true
# Адрес сайта для вебхука ревалидации ISR и общий секрет
WEB_URL=http://localhost:3000
REVALIDATE_SECRET=
