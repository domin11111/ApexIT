# Скопируйте в .env (корень) — его читают docker compose и apps/api.
# apps/api/.env, если есть, имеет приоритет над корневым.

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_USER=apex
POSTGRES_PASSWORD=apex
POSTGRES_DB=apex
DATABASE_URL=postgresql://apex:apex@localhost:5432/apex

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API ────────────────────────────────────────────────────
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# ── Сид ────────────────────────────────────────────────────
# В production сид не перезаписывает существующие продукты (правки из админки),
# пока явно не задано SEED_FORCE=1.
# SEED_FORCE=1

# ── Появятся на следующих этапах ───────────────────────────
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# CDN_URL=
# TURNSTILE_SECRET=
# SMTP_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SESSION_SECRET=
# TOTP_ENCRYPTION_KEY=
# REVALIDATE_WEBHOOK_SECRET=
