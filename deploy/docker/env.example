# Переменные полного стека для docker-compose.prod.yml.
# Скопируйте в .env.production (вне git) и заполните. Секреты — только там, не в compose-файле.

# Домены: сайт и S3-хранилище (оба A-записью на сервер)
SITE_DOMAIN=apex.example.com
S3_DOMAIN=s3.apex.example.com

# Образы из CI (ghcr.io). Пусто — :latest
# WEB_IMAGE=ghcr.io/domin11111/apex-web:<sha>
# API_IMAGE=ghcr.io/domin11111/apex-api:<sha>

POSTGRES_USER=apex
POSTGRES_PASSWORD=                 # openssl rand -hex 24
POSTGRES_DB=apex

S3_ACCESS_KEY=apex
S3_SECRET_KEY=                     # openssl rand -hex 24

# Cloudflare Turnstile: секрет виджета для SITE_DOMAIN (ключ сайта — build-arg образа web, см. CI)
TURNSTILE_SECRET=
LEAD_IP_SALT=                      # openssl rand -hex 16
TOTP_ENCRYPTION_KEY=               # openssl rand -base64 32
REVALIDATE_SECRET=                 # openssl rand -hex 24

# Уведомления о заявках (любой канал можно оставить пустым)
SMTP_URL=                          # smtps://user:pass@smtp.example.com:465
MAIL_FROM=APEX Compute <no-reply@apex.example.com>
LEAD_NOTIFY_EMAILS=sales@example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
